<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle configuration for push2u.

    Enforces what formatting cannot: naming conventions, Javadoc completeness on the public API,
    and import order. Layout rules (indentation, whitespace, braces, line wrapping) belong to
    Spotless (Palantir Java Format) and must NOT be duplicated here.

    push2u is a published library, so Javadoc on public types and methods is a hard requirement —
    it is the API documentation consumers see.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">

        <!-- ======================== -->
        <!-- Naming conventions       -->
        <!-- ======================== -->

        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
        </module>

        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="LocalFinalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>
        <module name="InterfaceTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>
        <module name="RecordTypeParameterName">
            <property name="format" value="^[A-Z][A-Z0-9]*$"/>
        </module>
        <module name="RecordComponentName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- ======================== -->
        <!-- Javadoc                  -->
        <!-- ======================== -->

        <!-- Javadoc on public types (classes, interfaces, enums, records) -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>

        <!--
            Javadoc on public methods, tags included: the code already documents every @param and
            @return, so the usual allowMissingParamTags/allowMissingReturnTag escape hatches would
            only permit a regression.
        -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
        </module>

        <!-- Public fields are part of the API surface — document them -->
        <module name="JavadocVariable">
            <property name="accessModifiers" value="public"/>
        </module>

        <!-- Validate Javadoc content when present -->
        <module name="JavadocContentLocation"/>
        <module name="NonEmptyAtclauseDescription"/>

        <!-- ======================== -->
        <!-- Import order             -->
        <!-- ======================== -->

        <!--
            Verifies the order Spotless produces:
            java.* / javax.* → blank line → third-party → blank line → com.the13haven.push2u.*

            Spotless is authoritative; Checkstyle only proves the result is what we expect.
            javax.* belongs to the first group because Spotless's "java" import-order entry matches
            by prefix, so javax.crypto sorts with the JDK packages (and the crypto code uses it
            heavily).
        -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules"
                      value="STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE###SPECIAL_IMPORTS"/>
            <property name="standardPackageRegExp" value="^javax?\."/>
            <property name="specialImportsRegExp" value="^com\.the13haven\.push2u\."/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <!-- Unused imports are removed by Spotless; flag them if one slips through -->
        <module name="UnusedImports"/>

    </module>

</module>
