<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        SpotBugs exclusion filter for push2u.
        Every exclusion must carry a comment explaining why the finding is a false positive here.
        See: https://spotbugs.readthedocs.io/en/stable/filter.html
    -->

    <!--
        EI_EXPOSE_REP: PushResponse's compact constructor rebuilds the header map with
        Collectors.toUnmodifiableMap, so the record component the accessor hands back is already
        immutable. SpotBugs only sees the Map interface and cannot tell.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.the13haven.push2u.PushResponse"/>
        <Field name="headers"/>
    </Match>

    <!--
        EI_EXPOSE_REP2: a java.security.Provider is a shared JCA service registry, not data. The
        caller passes the very instance it wants the crypto to run on — copying it (Provider extends
        Properties, so it is technically mutable) would defeat the point of the builder method.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Class name="com.the13haven.push2u.PushSender$Builder"/>
        <Field name="cryptoProvider"/>
    </Match>

    <!--
        EI_EXPOSE_REP: PushOutcome's two class-shaped variants exist to carry the seam's Throwable
        across the facade, and cause() handing back that very instance is the accessor's whole
        contract — the one deliberate way to the full diagnostic, documented as such. A Throwable is
        technically mutable (its cause chain and suppressed list), but a defensive copy of an
        exception is not a meaningful object, and neither outcome derives anything from the instance
        after construction — Indeterminate reads nothing from it at all, and SignerUnavailable
        snapshots the declared status and retry hint into final fields of its own in the
        constructor — so a caller mutating the exception, or a subtype overriding its accessors,
        changes nothing the outcome promised. The store side (EI_EXPOSE_REP2) does not fire because
        the constructor takes the exception the seam raised on purpose, for the same reason.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Or>
            <Class name="com.the13haven.push2u.PushOutcome$Indeterminate"/>
            <Class name="com.the13haven.push2u.PushOutcome$SignerUnavailable"/>
        </Or>
        <Field name="cause"/>
    </Match>

    <!--
        EI_EXPOSE_REP: Push2uProperties' compact constructor snapshots allowedOrigins and
        allowedDomains with List.copyOf, so each stored component is already an unmodifiable copy
        and the accessor hands back that immutable list. SpotBugs only sees the List interface and
        cannot tell — the same false-positive shape as PushResponse.headers above.

        EI_EXPOSE_REP2 is deliberately NOT excluded here: it does not fire precisely because the
        constructor copies, so it is the check that catches anyone later deleting either
        List.copyOf — the very fact this exclusion's justification depends on.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
        <Class name="com.the13haven.push2u.spring.Push2uProperties"/>
        <Or>
            <Field name="allowedOrigins"/>
            <Field name="allowedDomains"/>
        </Or>
    </Match>
</FindBugsFilter>
